{
  "name": "git-artifact",
  "version": "0.1.0",
  "description": "Live commit-graph dashboard for your repo. Local-first, read-only, no telemetry.",
  "type": "module",
  "license": "MIT",
  "author": "David Feldt <dsfeldt@gmail.com>",
  "homepage": "https://github.com/David-Feldt/git-artifact#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/David-Feldt/git-artifact.git"
  },
  "bugs": {
    "url": "https://github.com/David-Feldt/git-artifact/issues"
  },
  "keywords": [
    "git",
    "commit-graph",
    "dashboard",
    "worktree",
    "local-first",
    "cli",
    "claude-code"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "git-artifact": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "build:server": "node scripts/build-server.mjs",
    "build:client": "vite build",
    "dev": "node scripts/dev.mjs",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.2.0",
    "chokidar": "^4.0.3",
    "esbuild": "^0.25.12",
    "ignore": "^7.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
